# Local mockups & scratch utilities
mockup_*.html
css/editorial_*.css
seo_dashboard.html
start_seo_dashboard.bat
launch_seo_hidden.vbs
# `data/` holds generated SEO snapshots, which are noise. The metrics file is
# NOT noise: it is the declared source for the homepage figures, and
# scripts/check-metrics.mjs fails the build when the page disagrees with it. An
# ignored source of truth is not a source of truth.
data/*
!data/site-metrics.json
